{
  "name": "hedera-vnx-paid-swarm",
  "version": "1.0.0",
  "description": "Deterministic Verifiable Network Exchange (VNX) agent swarm with Hedera mainnet HBAR payment and cryptographically verifiable proof receipts",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./topic-oracle": {
      "types": "./dist/src/topic-oracle.d.ts",
      "import": "./dist/src/topic-oracle.js"
    },
    "./topic-creator": {
      "types": "./dist/src/topic-creator.d.ts",
      "import": "./dist/src/topic-creator.js"
    },
    "./pipeline": {
      "types": "./dist/src/pipeline-types.d.ts",
      "import": "./dist/src/pipeline-types.js"
    },
    "./domain-hcs": {
      "types": "./dist/src/domain-hcs-publisher.d.ts",
      "import": "./dist/src/domain-hcs-publisher.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/",
    "dist/scripts/",
    "docs/",
    "assets/",
    "data/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "bin": {
    "vnx-swarm-demo": "./dist/scripts/vnx-paid-swarm-demo.js",
    "vnx-swarm-e2e": "./dist/scripts/vnx-paid-swarm-e2e.js",
    "vnx-swarm-verify": "./dist/scripts/vnx-paid-swarm-verify-proof.js",
    "vnx-prediction-firehose": "./dist/scripts/vnx-prediction-firehose.js",
    "hcs-topic-publisher": "./dist/scripts/hcs-topic-publisher.js",
    "hcs-verify-agent": "./dist/scripts/hcs-verify-agent.js",
    "vnx-mainnet-demo": "./dist/scripts/render-mainnet-demo.js",
    "send-hbar": "./dist/scripts/send-hbar.js",
    "vnx-leaderboard": "./dist/scripts/leaderboard.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "demo:plan": "tsx scripts/vnx-paid-swarm-demo.ts --plan-only",
    "demo:live": "tsx scripts/vnx-paid-swarm-demo.ts --live",
    "e2e": "tsx scripts/vnx-paid-swarm-e2e.ts",
    "e2e:live": "tsx scripts/vnx-paid-swarm-e2e.ts --live",
    "verify": "tsx scripts/vnx-paid-swarm-verify-proof.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "demo:render": "tsx scripts/render-mainnet-demo.ts",
    "demo:firehose": "tsx scripts/vnx-prediction-firehose.ts",
    "demo:hcs": "tsx scripts/hcs-topic-publisher.ts",
    "verify:hcs": "tsx scripts/hcs-verify-agent.ts",
    "send": "tsx scripts/send-hbar.ts",
    "leaderboard": "tsx scripts/leaderboard.ts",
    "lint": "eslint src/ scripts/ tests/",
    "lint:fix": "eslint src/ scripts/ tests/ --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist/ coverage/ .tsbuildinfo",
    "scaffold": "tsx scripts/scaffold-domain.ts",
    "proof:expansion": "tsx scripts/run-expansion-proof.ts",
    "live-data:smoke": "tsx scripts/live-data-smoke.ts",
    "live:testnet:all": "tsx scripts/run-live-testnet-all.ts",
    "live:testnet:keep": "bash scripts/launch-testnet-persistent.sh",
    "live:testnet:burst800": "bash scripts/launch-testnet-burst-800.sh",
    "live:testnet:10k-1min": "bash scripts/launch-testnet-10k-1min.sh",
    "live:testnet:geo-sim": "bash scripts/geo-swarm/local-simulate.sh",
    "live:testnet:geo-sync": "bash scripts/geo-swarm/remote-sync.sh scripts/geo-swarm/nodes.json",
    "live:testnet:geo-10k": "bash scripts/geo-swarm/coordinator-10k.sh scripts/geo-swarm/nodes.json",
    "live:testnet:monitor": "bash scripts/monitor-testnet-swarm.sh",
    "live:testnet:topup": "bash scripts/topup-testnet-operator.sh",
    "bounty:deck": "node docs/hedera-bounty-video/build-deck.mjs"
  },
  "keywords": [
    "hedera",
    "hiero",
    "hbar",
    "micro-swarm",
    "agent-swarm",
    "deterministic",
    "consensus",
    "cryptographic-proof",
    "verifiable-receipt",
    "mainnet",
    "typescript",
    "cli"
  ],
  "author": "Vera Lattice <vera@lattice.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/livevnx8/hedera-vnx-paid-swarm.git"
  },
  "bugs": {
    "url": "https://github.com/livevnx8/hedera-vnx-paid-swarm/issues"
  },
  "homepage": "https://github.com/livevnx8/hedera-vnx-paid-swarm#readme",
  "dependencies": {
    "@hashgraph/sdk": "^2.60.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
