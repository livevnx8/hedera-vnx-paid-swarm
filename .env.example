# Hedera VNX Paid Micro-Swarm — Environment Configuration
#
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git. It is already in .gitignore.
#
# For competition runs, all three credentials below are required.
# For local development, use --plan-only to skip payment entirely.

# ─── HEDERA ACCOUNT ─────────────────────────────────────────

# Your Hedera Account ID (e.g. 0.0.10294360)
# Get this from HashPack, Blade, or your Hedera portal.
HEDERA_ACCOUNT_ID=0.0.YOUR_ACCOUNT

# Your ECDSA private key as a hex string (no 0x prefix)
# KEEP THIS SECRET. Never share, screenshot, or commit it.
HEDERA_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# ─── NETWORK ────────────────────────────────────────────────

# mainnet  = live Hedera network (real HBAR, real fees)
# testnet  = Hedera testnet (free, for development)
# previewnet = Hedera previewnet (bleeding edge)
#
# Competition submissions MUST use mainnet.
HEDERA_NETWORK=mainnet

# ─── OPTIONAL SWARM CONFIG ──────────────────────────────────

# Maximum HBAR any single swarm payment can transfer (default: 0.01)
# This is a safety cap. The coordinator rejects anything above it.
# MAX_HBAR_CAP=0.01

# ─── OPTIONAL MIRROR NODE ───────────────────────────────────

# Override the default Hiero mirror node REST API base URL.
# Default: https://mainnet-public.mirrornode.hedera.com
# MIRROR_NODE_URL=https://mainnet-public.mirrornode.hedera.com
