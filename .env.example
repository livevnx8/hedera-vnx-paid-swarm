# Hedera VNX Paid Micro-Swarm — Environment Configuration
#
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git. It is already in .gitignore.

# Hedera Account ID (e.g., 0.0.10294360)
HEDERA_ACCOUNT_ID=0.0.YOUR_ACCOUNT

# ECDSA private key (hex string, no 0x prefix)
HEDERA_PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Network — must be "mainnet" for competition submissions
HEDERA_NETWORK=mainnet

# Optional: override max HBAR cap (default 0.01)
# MAX_HBAR_CAP=0.01
